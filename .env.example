# Discord Bot トークン（https://discord.com/developers/applications で取得）
DISCORD_TOKEN=your_discord_bot_token_here

# よあコイン API キー（Discordで `y!apikey new` を実行して取得）
YOACOIN_API_KEY=yoak_xxxxxxxxxxxxxxxxxxxx

# よあコイン API ベースURL（通常は変更不要）
YOACOIN_BASE_URL=https://yoacoin-api.keitodaze.net/api/v1

# SQLite データベースの保存先
DB_PATH=yoacoin_bot.db

# 入金ポーリング間隔（秒）。ドキュメント推奨に従い数秒。1秒未満にはしないこと。
POLL_INTERVAL_SECONDS=5

# スラッシュコマンドを即時同期させたい開発用サーバー(ギルド)ID（任意・空なら全体同期）
DEV_GUILD_ID=

# 社長（/economy・/payouts を実行できる唯一のユーザーID）。既定はオーナー本人。
# （開発者モードON → 自分のアイコン右クリック →「IDをコピー」）
OWNER_ID=1084039929878810624

# ===== 経済（よあコイン建て） =====
# 会社の初期準備金（よあコイン）。目標は 50000。
COMPANY_START_RESERVE=30000

# 準備金フロア：これを割る払い出しは拒否（支払い保証・破綻防止）
RESERVE_FLOOR=5000

# 換金手数料（basis point）。1000 = 10%。リリーコイン→よあコイン化のハウスエッジ＝会社利益。
WITHDRAW_FEE_BPS=1000

# 最低換金額・換金クールダウン（秒）：微farming 抑止
MIN_WITHDRAW=100
WITHDRAW_COOLDOWN=300

# ジェム1個の価格（リリーコイン）。120 = 120リリーコインで1ジェム。
# quests.GEM_VALUE_COINS（報酬の価値換算）と合わせておくこと。
GEM_PRICE_COINS=120

# 換金用の新API(POST /payout)が使えるか。
# 採用済みなら true（/cashout が自動で払い出し）。未採用なら false（換金は申請キューに積む）。
PAYOUT_ENABLED=true

# 残高取得API(GET /users/{id}/balance)が使えるか。true で /balance に実グローバル残高を表示。
BALANCE_API_ENABLED=false

# 課金API(POST /charge, ユーザー→会社)が使えるか。将来 よあコイン→リリーコイン即時交換等に使用。
CHARGE_ENABLED=false

# 会社名（Discordの `y!支払 <会社名> <額>` で使う）。/deposit の案内に表示される。
COMPANY_NAME=おちんぽグループ

# 入金→リリーコイン変換完了を知らせるチャンネルID（任意）。
# 設定するとDMに加えてこのチャンネルにも通知。空ならDMのみ。
# （開発者モードON → チャンネル右クリック →「IDをコピー」）
NOTIFY_CHANNEL_ID=
